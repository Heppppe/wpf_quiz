<UserControl x:Class="Quiz_Solver_App.View.MainMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Quiz_Solver_App.View"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200"
             Background="{StaticResource BackgroundBrush}">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" >
        <TextBlock Text="Aplikacja rozwiązywania quizu"
           FontSize="40"
                   Foreground="{StaticResource TextBrush}"
           FontWeight="Bold"
           HorizontalAlignment="Center"/>
        <Label Content="Autor: Kacper Manterys" FontSize="28" FontWeight="Bold" Margin="0,10,0,50" HorizontalAlignment="Center"
               Foreground="{StaticResource TextBrush}"/>
        <Label Content="Wybierz quiz do rozwiązania z listy, lub wybierz plik quizu '.json' ręcznie:"
               FontSize="14" FontWeight="Heavy" Margin="0,0,0,15"
               Foreground="{StaticResource SecondaryBrush}"/>
        <ListBox ItemsSource="{Binding Quizzes}"
                 Background="{StaticResource PrimaryBrush}" Foreground="{StaticResource TextBrush}"
         SelectedItem="{Binding SelectedQuiz}"
         BorderThickness="0"
                 Height="150">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="5">
                        <TextBlock Text="{Binding Title}" FontSize="16" DockPanel.Dock="Left" VerticalAlignment="Center" />
                        <Button Content="Rozwiąż"
                        Width="60"
                        Margin="10 0 0 0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Background="{StaticResource AccentBrush}"
                        Foreground="{StaticResource BackgroundBrush}"
                        Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button Content="Wybierz plik .json" FontSize="16" FontWeight="DemiBold"
                Background="{StaticResource AccentBrush}"
                Foreground="{StaticResource BackgroundBrush}"
            Command="{Binding SelectJsonFileCommand}"  CommandParameter="1"
            Width="200" Height="40" Margin="10,10,10,25"/>
    </StackPanel>
</UserControl>
